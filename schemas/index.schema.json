{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 240
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "superseded"
            ]
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "asset_id",
          "kind",
          "tags",
          "summary",
          "path",
          "sha256",
          "version",
          "status",
          "supersedes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "entries"
  ],
  "additionalProperties": false
}

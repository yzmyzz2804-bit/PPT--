{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "extracted_pages": {
            "type": "integer",
            "minimum": 0
          },
          "needs_ocr": {
            "type": "boolean"
          },
          "spot_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "readable",
              "partial",
              "unreadable"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "asset_id",
          "path",
          "source_sha256",
          "page_count",
          "extracted_pages",
          "needs_ocr",
          "spot_checks",
          "status",
          "issues"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "files"
  ],
  "additionalProperties": false
}

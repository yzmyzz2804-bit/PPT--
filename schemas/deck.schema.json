{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "claims_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "constraints_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "enum": [
              "reporting",
              "print_a3",
              "print_same_slides"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "cover",
              "section",
              "conclusion_evidence",
              "comparison",
              "trend",
              "process",
              "table_appendix",
              "summary_actions"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "core_message": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_page_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layout_id": {
            "type": "string",
            "minLength": 1
          },
          "speaker_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "protected_change_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "page_id",
          "profile",
          "type",
          "title",
          "core_message",
          "claim_ids",
          "asset_ids",
          "source_page_ids",
          "layout_id",
          "speaker_notes",
          "protected_change_ids"
        ],
        "additionalProperties": false
      }
    },
    "protected_change_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "target_path",
          "scope",
          "before_sha256",
          "after_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "version",
    "claims_sha256",
    "constraints_sha256",
    "selection_sha256",
    "pages",
    "protected_change_refs"
  ],
  "additionalProperties": false
}

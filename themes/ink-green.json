{
  "_meta": {
    "name": "ink-green",
    "label": "墨绿沉稳",
    "description": "墨绿主色 + 暖灰中性色，适合强调生态/低碳/可持续叙事的建筑规划项目。",
    "version": "1.0"
  },

  "colors": {
    "brand": {
      "primary": "#1F3D2E",
      "secondary": "#2D5A40",
      "accent": "#3F8A5C",
      "accent_bright": "#5BAE78",
      "accent_light": "#8FCBA0",
      "accent_lighter": "#B8DEC4",
      "accent_lightest": "#E0EFE5"
    },
    "neutral": {
      "black": "#000000",
      "text_secondary": "#6B7568",
      "divider": "#C5CCC0",
      "card_border": "#DDE3D9",
      "bg_card": "#F2F5EF",
      "bg_page": "#F8FAF6",
      "white": "#FFFFFF"
    },
    "semantic": {
      "success": "#3F8A5C",
      "warning": "#B8472D"
    }
  },

  "typography": {
    "font_cn": "Microsoft YaHei, PingFang SC, Noto Sans SC, sans-serif",
    "font_en": "Arial, Helvetica, Inter, sans-serif",
    "font_num": "Arial, Helvetica, Inter, sans-serif",
    "scale": {
      "mega_title": "84px",
      "hero_title": "56px",
      "page_title": "34px",
      "card_title": "22px",
      "body": "17px",
      "caption": "13px",
      "en_label": "13px"
    },
    "weight": { "cn_title": 700, "cn_body": 400, "en_label": 600, "number": 600 },
    "letter_spacing_en": "2px"
  },

  "layout": {
    "canvas_w": "1920px",
    "canvas_h": "1080px",
    "safe_margin": "80px",
    "brand_mark_pos": { "top": "50px", "left": "60px" }
  },

  "components": {
    "card": {
      "radius": "6px",
      "padding": "24px",
      "border": "1px solid #DDE3D9",
      "accent_bar": { "top": "3px", "color": "#3F8A5C" }
    },
    "divider": {
      "color": "#C5CCC0",
      "thickness": "1px",
      "decorative_short": "36px"
    }
  },

  "principles": [
    "克制用色：主色只用墨绿系，每页强调色≤2处",
    "大留白：边距 80-100px，元素不拥挤",
    "中英双标题：所有中文标题配英文小字副标题",
    "数据放大：关键数据用大字号突出",
    "装饰极简：只用方块+横线的品牌标识",
    "左对齐为主，数字卡片可居中",
    "图文分栏明确：图占主视觉区（>50%宽度）",
    "信息层级清晰：每页不超过3级标题层级"
  ]
}

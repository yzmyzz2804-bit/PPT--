{
  "_meta": {
    "name": "black-white-grey",
    "label": "黑白灰极简",
    "description": "无彩色系，纯黑白灰，适合学术汇报、政府评审、强克制叙事场景。",
    "version": "1.0"
  },

  "colors": {
    "brand": {
      "primary": "#1A1A1A",
      "secondary": "#333333",
      "accent": "#666666",
      "accent_bright": "#888888",
      "accent_light": "#AAAAAA",
      "accent_lighter": "#CCCCCC",
      "accent_lightest": "#EEEEEE"
    },
    "neutral": {
      "black": "#000000",
      "text_secondary": "#666666",
      "divider": "#CCCCCC",
      "card_border": "#E0E0E0",
      "bg_card": "#F5F5F5",
      "bg_page": "#FAFAFA",
      "white": "#FFFFFF"
    },
    "semantic": {
      "success": "#444444",
      "warning": "#000000"
    }
  },

  "typography": {
    "font_cn": "Microsoft YaHei, PingFang SC, Noto Sans SC, sans-serif",
    "font_en": "Arial, Helvetica, Inter, sans-serif",
    "font_num": "Arial, Helvetica, Inter, sans-serif",
    "scale": {
      "mega_title": "84px",
      "hero_title": "56px",
      "page_title": "34px",
      "card_title": "22px",
      "body": "17px",
      "caption": "13px",
      "en_label": "13px"
    },
    "weight": { "cn_title": 700, "cn_body": 400, "en_label": 600, "number": 600 },
    "letter_spacing_en": "2px"
  },

  "layout": {
    "canvas_w": "1920px",
    "canvas_h": "1080px",
    "safe_margin": "80px",
    "brand_mark_pos": { "top": "50px", "left": "60px" }
  },

  "components": {
    "card": {
      "radius": "6px",
      "padding": "24px",
      "border": "1px solid #E0E0E0",
      "accent_bar": { "top": "3px", "color": "#1A1A1A" }
    },
    "divider": {
      "color": "#CCCCCC",
      "thickness": "1px",
      "decorative_short": "36px"
    }
  },

  "principles": [
    "无彩色系：仅黑白灰，强调排版与字体节奏",
    "大留白：边距 100-120px，极致克制",
    "中英双标题：所有中文标题配英文小字副标题",
    "数据放大：关键数据用大字号 + 粗字重突出",
    "装饰极简：只用方块+横线的品牌标识",
    "左对齐为主，数字卡片可居中",
    "图为主、字为辅：图占主视觉区（>50%宽度）",
    "信息层级清晰：每页不超过3级标题层级"
  ]
}

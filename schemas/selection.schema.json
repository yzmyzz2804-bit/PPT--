{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "option_id": {
      "type": "string",
      "minLength": 1
    },
    "options_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "run_id",
    "option_id",
    "options_sha256",
    "rationale"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "protected_changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "option_id",
          "summary",
          "tradeoffs",
          "protected_changes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "options"
  ],
  "additionalProperties": false
}
